# Server-side secrets. Do not place real values in public source control.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_cpanel_db
MYSQL_USER=your_cpanel_user
MYSQL_PASSWORD=your_cpanel_password

# Scamalytics Fraud Risk API (v3)
SCAMALYTICS_USER=your_scamalytics_username
SCAMALYTICS_KEY=your_scamalytics_api_key

# Neon PostgreSQL Database Connection String (Optional Secondary)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-1.aws.neon.tech/neondb?sslmode=require

# Access Control
ACCESS_ALLOWED_IPS=103.156.189.77,103.156.189.78,103.156.189.*,127.0.0.1,::1
ACCESS_USERNAME=admin
ACCESS_PASSWORD=replace-with-a-long-random-password
ACCESS_SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Provider keys
VERIPHONE_KEY=your_veriphone_api_key
AI_STUDIO_KEY=your_gemini_api_key_here
PORT=3000
